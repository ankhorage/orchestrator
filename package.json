{
  "name": "@ankhorage/orchestrator",
  "version": "0.2.3",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/orchestrator.git"
  },
  "homepage": "https://github.com/ankhorage/orchestrator#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/orchestrator/issues"
  },
  "keywords": [
    "typescript",
    "bun",
    "orchestration",
    "automation",
    "developer-tools",
    "modules"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "ankh": {
    "category": "orchestrator",
    "provider": null,
    "capabilities": []
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "test": "bun test",
    "knip": "ankhorage-knip",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.0.6",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.13",
  "publishConfig": {
    "access": "public"
  }
}
