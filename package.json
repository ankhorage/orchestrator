{
  "name": "@ankhorage/orchestrator",
  "version": "0.4.0",
  "description": "Headless lifecycle engine for deterministic Ankhorage project modules.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/orchestrator.git"
  },
  "homepage": "https://github.com/ankhorage/orchestrator#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/orchestrator/issues"
  },
  "keywords": [
    "ankhorage",
    "automation",
    "bun",
    "developer-tools",
    "modules",
    "orchestration",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "default": "./dist/capabilities/index.js"
    }
  },
  "ankh": {
    "category": "orchestrator",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "orchestrator.modules",
        "owner": "@ankhorage/orchestrator",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "List modules",
        "description": "List modules available to an orchestrator-backed host."
      },
      {
        "id": "orchestrator.install",
        "owner": "@ankhorage/orchestrator",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Install module",
        "description": "Install a module through an orchestrator-backed host lifecycle."
      },
      {
        "id": "orchestrator.remove",
        "owner": "@ankhorage/orchestrator",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Remove module",
        "description": "Remove a module through an orchestrator-backed host lifecycle."
      }
    ]
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "docs": "ankhorage-prettier --check README.md",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip",
    "changeset:status": "ankhorage-changeset status --since=origin/main"
  },
  "dependencies": {
    "@ankhorage/ankh": "^0.12.0",
    "@ankhorage/contracts": "^24.1.0"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.1.19",
    "@ankhorage/doctor": "^0.10.8",
    "@types/bun": "^1.4.2",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  }
}
